  const [healthProfile, setHealthProfile] = useState(() => {
    const stored = readStorage(HEALTH_PROFILE_STORAGE_KEY, {})
    const saved = stored && typeof stored === 'object' ? stored : {}
    return {
      name: typeof saved.name === 'string' ? saved.name : '',
      conditions: Array.isArray(saved.conditions) ? saved.conditions : [],
      familyName: typeof saved.familyName === 'string' ? saved.familyName : '',
      familyNumber: typeof saved.familyNumber === 'string' ? saved.familyNumber : '',
    }
  })
  const [prescriptionSource, setPrescriptionSource] = useState(() => {
    const savedSource = readStorage(PRESCRIPTION_SOURCE_STORAGE_KEY, '')
    if (['ai', 'demo', 'unknown'].includes(savedSource)) return savedSource
    const savedMedicines = readStorage(MEDICINES_STORAGE_KEY, [])
    return Array.isArray(savedMedicines) && savedMedicines.length ? 'unknown' : 'empty'
  })
  const [activeScreen, setActiveScreen] = useState('prescription')
  const [loading, setLoading] = useState(false)
  const [error, setError] = useState('')
  const [selectedImage, setSelectedImage] = useState(null)
  const [previewUrl, setPreviewUrl] = useState('')
  const [isSelectedImageAnalyzed, setIsSelectedImageAnalyzed] = useState(false)
  const [editingMedicineIds, setEditingMedicineIds] = useState([])
  const [medicineValidationErrors, setMedicineValidationErrors] = useState({})
  const [voiceFields, setVoiceFields] = useState({})
  const [voiceEntry, setVoiceEntry] = useState({ medicineId: '', status: 'idle', message: '' })
  const [isSpeaking, setIsSpeaking] = useState(false)
  const [speechMessage, setSpeechMessage] = useState('')
  const [interactionCheck, setInteractionCheck] = useState(null)
  const [interactionLoading, setInteractionLoading] = useState(false)
  const [interactionError, setInteractionError] = useState('')
  const recognitionRef = useRef(null)
  const voiceRequestRef = useRef(0)
  const speechRequestRef = useRef(0)

  useEffect(() => {
    if (!previewUrl) return undefined
    return () => URL.revokeObjectURL(previewUrl)
  }, [previewUrl])

  useEffect(() => () => {
    voiceRequestRef.current += 1
    recognitionRef.current?.abort()
    window.speechSynthesis?.cancel()
  }, [])

  useEffect(() => {
    writeStorage(MEDICINES_STORAGE_KEY, medicines, medicines.length === 0)
  }, [medicines])

  useEffect(() => {
    writeStorage(PRESCRIPTION_SOURCE_STORAGE_KEY, prescriptionSource, prescriptionSource === 'empty')
  }, [prescriptionSource])

  useEffect(() => {
    writeStorage(TAKEN_STORAGE_KEY, taken, Object.keys(taken).length === 0)
  }, [taken])

  useEffect(() => {
    const hasProfile = Boolean(
      healthProfile.name
      || healthProfile.conditions.length
