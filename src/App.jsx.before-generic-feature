  const warnings = useMemo(
    () => medicines.every((medicine) => medicine.verified)
      ? getInteractions(medicines)
      : [],
    [medicines],
  )
  const showHealthNsaidWarning = medicines.every((medicine) => medicine.verified)
    && healthProfile.conditions.some((condition) =>
    condition === 'Diabetes' || condition === 'High BP',
  ) && containsNsaid(medicines.filter((medicine) => medicine.verified))

