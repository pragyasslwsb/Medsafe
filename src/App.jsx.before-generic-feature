function writeStorage(key, value, shouldRemove = false) {
  try {
    if (shouldRemove) window.localStorage.removeItem(key)
    else window.localStorage.setItem(key, JSON.stringify(value))
  } catch (storageError) {
    console.error('Could not update saved MedSafe data:', storageError.message)
  }
}

function readStorage(key, fallback) {
  try {
    const saved = window.localStorage.getItem(key)
    return saved ? JSON.parse(saved) : fallback
  } catch {
    return fallback
  }
}

function makeMedicineId(index) {
  return `${Date.now()}-${index}`
}

function asMedicines(items) {
  return items.map((medicine, index) => ({
    name: '',
    generic_name: '',
    dose: '',
    frequency: '',
    timing: '',
    duration: '',
    instructions: '',
    confidence: 0,
    hindi: '',
    uncertain_fields: [],
    verified: false,
    expiry_date: '',
    id: makeMedicineId(index),
    ...medicine,
  }))
}

function getConfirmedField(medicine, field) {
  const value = typeof medicine[field] === 'string' ? medicine[field].trim() : ''
  const uncertainFields = Array.isArray(medicine.uncertain_fields) ? medicine.uncertain_fields : []
  const unclearPlaceholder = /^(needs verification|unknown|unclear|unreadable|illegible|not readable|not legible|n\/?a|none)$/i
  return value && !uncertainFields.includes(field) && !unclearPlaceholder.test(value) ? value : ''
}

function getScheduleSlots(medicine) {
  if (!medicine.verified) return []
  const text = `${medicine.frequency || ''} ${medicine.timing || ''}`.toLowerCase()
  if (!text.trim() || /as needed|when required|prn/.test(text)) return []

  const indianSchedule = text.match(/(?:^|\s)([01])\s*[-–/]\s*([01])\s*[-–/]\s*([01])(?:\s|$)/)
  if (indianSchedule) return slots.filter((_, index) => indianSchedule[index + 1] === '1')

  const timingSlots = slots.filter((slot) => {
    if (slot === 'morning') return /morning|breakfast|सुबह/.test(text)
    if (slot === 'afternoon') return /afternoon|lunch|दोपहर/.test(text)
    return /night|evening|bedtime|dinner|रात/.test(text)
  })

  return timingSlots
}

function normalize(value) {
  return (value || '').toLocaleLowerCase().replace(/[^a-z0-9]+/g, ' ').trim()
}

function containsDrug(medicine, drug) {
  const haystack = normalize(`${medicine.name} ${medicine.generic_name}`)
  const needle = normalize(drug)
  if (!needle) return false
  const brandAliases = generics
    .filter((item) => normalize(item.generic_name) === needle)
    .map((item) => normalize(item.brand))
  const aliases = needle === 'aspirin' ? ['acetylsalicylic acid', 'ecosprin'] : []
  return [needle, ...brandAliases, ...aliases].some((candidate) =>
    ` ${haystack} `.includes(` ${candidate} `),
  )
}

function getInteractions(medicines) {
  return interactions.filter((interaction) =>
    interaction.drugs.every((drug) => medicines.some((medicine) => containsDrug(medicine, drug))),
  )
}

function containsNsaid(medicines) {
  return medicines.some((medicine) => {
    const text = normalize(`${medicine.name} ${medicine.generic_name}`)
    return [
      'ibuprofen', 'brufen', 'diclofenac', 'voveran', 'naproxen',
      'aceclofenac', 'nimesulide', 'etoricoxib', 'celecoxib',
      'ketorolac', 'indomethacin', 'meloxicam',
    ].some((drug) => ` ${text} `.includes(` ${drug} `))
  })
}

function getTodayKey() {
  const date = new Date()
  const year = date.getFullYear()
  const month = String(date.getMonth() + 1).padStart(2, '0')
  const day = String(date.getDate()).padStart(2, '0')
  return `${year}-${month}-${day}`
}

function dateOrdinal(dateValue) {
  const [year, month, day] = dateValue.split('-').map(Number)
  const adjustedYear = year - (month <= 2 ? 1 : 0)
  const era = Math.floor(adjustedYear / 400)
  const yearOfEra = adjustedYear - era * 400
  const shiftedMonth = month + (month > 2 ? -3 : 9)
  const dayOfYear = Math.floor((153 * shiftedMonth + 2) / 5) + day - 1
  const dayOfEra = yearOfEra * 365 + Math.floor(yearOfEra / 4) - Math.floor(yearOfEra / 100) + dayOfYear
  return era * 146097 + dayOfEra
}

const TODAY_KEY = getTodayKey()

function App() {
  const { language, setLanguage, t } = useLanguage()
  const [medicines, setMedicines] = useState(() => {
