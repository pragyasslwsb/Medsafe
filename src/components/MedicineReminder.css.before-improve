/* Change these 4 colors to match your MedSafe theme */
.reminder {
  --rm-accent: #0f766e;
  --rm-bg: #ffffff;
  --rm-text: #1f2933;
  --rm-border: #d5dde3;

  max-width: 520px;
  margin: 24px auto;
  padding: 20px;
  background: var(--rm-bg);
  color: var(--rm-text);
  border: 1px solid var(--rm-border);
  border-radius: 10px;
  font-family: inherit;
}

.reminder h2 {
  margin: 0 0 16px;
  font-size: 1.25rem;
}

.reminder form {
  display: grid;
  gap: 12px;
  margin-bottom: 20px;
}

.reminder label {
  display: grid;
  gap: 4px;
  font-size: 0.9rem;
}

.reminder input[type="text"],
.reminder input[type="date"],
.reminder input[type="time"],
.reminder select {
  padding: 8px 10px;
  border: 1px solid var(--rm-border);
  border-radius: 6px;
  font: inherit;
  background: #fff;
  color: var(--rm-text);
}

.reminder button {
  padding: 8px 14px;
  border: 0;
  border-radius: 6px;
  background: var(--rm-accent);
  color: #fff;
  font: inherit;
  cursor: pointer;
}

.reminder button:focus-visible,
.reminder input:focus-visible,
.reminder select:focus-visible {
  outline: 2px solid var(--rm-accent);
  outline-offset: 2px;
}

.reminder .rm-secondary,
.reminder .rm-delete {
  background: transparent;
  color: var(--rm-text);
  border: 1px solid var(--rm-border);
}

.reminder .rm-error {
  margin: 0;
  color: #b42318;
  font-size: 0.9rem;
}

.reminder .rm-list {
  list-style: none;
  margin: 0;
  padding: 0;
}

.rm-item {
  display: flex;
  align-items: center;
  gap: 12px;
  padding: 10px 0;
  border-top: 1px solid var(--rm-border);
}

.rm-main {
  flex: 1;
  display: grid;
  gap: 2px;
}

.rm-info {
  font-weight: 600;
}

.rm-when {
  font-size: 0.85rem;
  opacity: 0.75;
}

.rm-left {
  font-weight: 600;
  font-variant-numeric: tabular-nums;
  color: var(--rm-accent);
}

.rm-off .rm-main {
  opacity: 0.45;
}

.rm-empty {
  color: #6b7780;
  padding: 8px 0;
}

.rm-alerts {
  display: grid;
  gap: 10px;
  margin-bottom: 16px;
}

.rm-alert {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 10px;
  padding: 12px;
  border: 2px solid var(--rm-accent);
  border-radius: 8px;
}

.rm-alert p {
  flex: 1 1 100%;
  margin: 0;
  font-weight: 600;
}
/* Popup that shows on every tab */
.rm-overlay {
  --rm-accent: #0f766e;
  --rm-text: #1f2933;
  --rm-border: #d5dde3;

  position: fixed;
  inset: 0;
  z-index: 9999;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 16px;
  background: rgba(0, 0, 0, 0.6);
}

.rm-popup {
  display: grid;
  gap: 14px;
  width: 100%;
  max-width: 420px;
  padding: 24px;
  background: #ffffff;
  color: var(--rm-text);
  border-radius: 12px;
  text-align: center;
  font-family: inherit;
}

.rm-popup h3 {
  margin: 0;
  font-size: 1.35rem;
}

.rm-overlay .rm-alert {
  justify-content: center;
}

.rm-overlay button {
  padding: 10px 16px;
  border: 0;
  border-radius: 6px;
  background: var(--rm-accent);
  color: #fff;
  font: inherit;
  cursor: pointer;
}

.rm-overlay .rm-secondary {
  background: transparent;
  color: var(--rm-text);
  border: 1px solid var(--rm-border);
}

.reminder .rm-test {
  margin: 0;
  font-size: 0.9rem;
}